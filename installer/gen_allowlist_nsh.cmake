#
# Generates Allowlist.nsh for DisplayXROpenConversionInstaller.nsi: the ADR-054 N4b
# provenance allowlist row for the provider DLL this installer ships.
#
# Adapted from displayxr-runtime/installer/gen_allowlist_nsh.cmake; the row format
# (value name = SHA-256 hex digest under HKLM\Software\DisplayXR\Trust\Allowlist)
# is the runtime's, unchanged.
#
# The provenance gate ENFORCES by default on Windows (PR B): a plug-in binary
# must be Authenticode-signed or have its SHA-256 under
# HKLM\Software\DisplayXR\Trust\Allowlist, or the loader refuses it. A signed
# release passes on the signature alone; an unsigned build (CI, a dev
# `build_windows.bat installer`, a release the signing provider missed) would
# otherwise install a provider the runtime then refuses as `unverified` (the
# 0.1.0 release did exactly that). So the installer writes the digest of exactly
# the bytes it ships, computed here at packaging time, and the uninstaller
# removes the same row. Only the provider DLL is gated: ONNX Runtime and DirectML
# are loaded by the provider itself, not by the runtime's component loader.
#
# Invoked by the release workflow before makensis:
#   cmake -DBIN_DIR=<dist> -DVERSION=<x.y.z> -DOUT=<Allowlist.nsh> -P installer/gen_allowlist_nsh.cmake

if(NOT DEFINED BIN_DIR OR NOT DEFINED OUT)
	message(FATAL_ERROR "gen_allowlist_nsh.cmake: BIN_DIR and OUT are required")
endif()
if(NOT DEFINED VERSION)
	set(VERSION "dev")
endif()

# The one runtime-loaded binary in the `cmake --install` tree (DIST_DIR).
set(_shipped_plugins
	"${BIN_DIR}/DisplayXR-OpenConversion.dll"
)

set(_write "")
set(_remove "")
foreach(_dll IN LISTS _shipped_plugins)
	if(NOT EXISTS "${_dll}")
		message(FATAL_ERROR "gen_allowlist_nsh.cmake: shipped plug-in missing: ${_dll}")
	endif()
	file(SHA256 "${_dll}" _hex)
	get_filename_component(_name "${_dll}" NAME)
	string(APPEND _write
		"\tWriteRegStr HKLM \"Software\\DisplayXR\\Trust\\Allowlist\" \"${_hex}\" \"${_name} (DisplayXR Open Conversion installer ${VERSION})\"\n")
	string(APPEND _remove
		"\tDeleteRegValue HKLM \"Software\\DisplayXR\\Trust\\Allowlist\" \"${_hex}\"\n")
	message(STATUS "allowlist: ${_name} sha256=${_hex}")
endforeach()

file(WRITE "${OUT}"
	"; Auto-generated by installer/gen_allowlist_nsh.cmake — do not edit.\n"
	"; ADR-054 N4b provenance allowlist row for the provider DLL this installer ships.\n"
	"!macro DXR_ALLOWLIST_WRITE\n"
	"${_write}"
	"!macroend\n"
	"!macro DXR_ALLOWLIST_REMOVE\n"
	"${_remove}"
	"\tDeleteRegKey /ifempty HKLM \"Software\\DisplayXR\\Trust\\Allowlist\"\n"
	"\tDeleteRegKey /ifempty HKLM \"Software\\DisplayXR\\Trust\"\n"
	"!macroend\n")
